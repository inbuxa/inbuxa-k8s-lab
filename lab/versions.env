# Pinned versions for the lab. Bump deliberately, in their own PR.
KIND_CLUSTER=inbuxa-lab
CNPG_CHART=0.29.2          # CloudNativePG operator 1.30.2
NATS_CHART=2.15.2
METALLB_CHART=0.16.2
KYVERNO_CHART=3.9.2        # Kyverno 1.19.2
GARAGE_IMAGE=docker.io/dxflrs/garage:v2.5.0
PG_IMAGE=ghcr.io/cloudnative-pg/postgresql:17
SERVER_IMAGE=${SERVER_IMAGE:-ghcr.io/inbuxa/inbuxa-server:27.1-rc.27}
# K-L10: the GitOps controllers, each as its project's install manifest,
# checked by SHA-256 before it's applied. Flux publishes the sum
# (flux_<v>_checksums.txt); Argo CD doesn't, so its sum is the one taken
# when the pin was set.
ARGOCD_VERSION=v3.6.2
ARGOCD_CORE_SHA256=7d39e823fa236666a512bdd294f307360a59f7865e6936fed49fd7b57d348a3f
FLUX_VERSION=v2.10.1
FLUX_INSTALL_SHA256=4db2fb9ce179622327d3a9a36a765bbfc0329fd50690e8d37da7dd0918b09392
# The 2026.x release the GitOps runs cross from (chart/crossing-test.sh)
CROSSING_FROM=2026.11.18.3
